# Copy to a sealed secret or create with oc; do not commit real passwords.
# oc create secret generic model-registry-mysql -n rhoai-model-registries \
#   --from-literal=database-name=modelregistry \
#   --from-literal=database-user=mlmduser \
#   --from-literal=database-password='...' \
#   --from-literal=database-root-password='...'
apiVersion: v1
kind: Secret
metadata:
  name: model-registry-mysql
  namespace: rhoai-model-registries
type: Opaque
stringData:
  database-name: modelregistry
  database-user: mlmduser
  database-password: CHANGE_ME
  database-root-password: CHANGE_ME
